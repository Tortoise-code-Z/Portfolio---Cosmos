# A `main` solo llegan por push los commits de documentación (ADR-033); todo lo demás, por PR. El criterio está en
# `scripts/docs-only.ts`, y ante cualquier duda (una rama nueva, un commit que no está en local) el push se para.
# Git da una línea por rama: <ref local> <hash local> <ref remota> <hash remoto>.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ] && ! node scripts/docs-only.ts "$remote_sha" "$local_sha"; then
    echo "pre-push: only docs (.md outside src/, tests/ and public/) go straight to main; the rest, through a PR." >&2
    echo "pre-push: if a PR was just merged, run git pull first." >&2
    exit 1
  fi
done
npm run typecheck && npm test
